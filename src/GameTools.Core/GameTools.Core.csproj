<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>GameTools.Core</RootNamespace>
    <AssemblyName>GameTools.Core</AssemblyName>
    <!--
      契约层收敛为 netstandard2.0：不依赖 WinForms、GDI+ 与任何 UI 框架，
      可被任意目标框架引用并在非 Windows 平台上参与单元测试。
    -->
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

</Project>