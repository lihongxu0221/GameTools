<Window x:Class="GameTools.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameTools 底层交互工具" Height="760" Width="1280"
        MinHeight="560" MinWidth="1000"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 顶部标题栏 -->
    <Border Grid.Row="0" Background="#1F2937" Padding="16,10">
      <StackPanel>
        <TextBlock Text="GameTools 底层交互工具" Foreground="White" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="{Binding StatusSummary}" Foreground="#B8C2D1" FontSize="12" Margin="0,3,0,0" />
      </StackPanel>
    </Border>

    <!-- 主体：左侧功能面板 + 分隔条 + 右侧日志 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <!-- 固定列宽同时给出 Min/Max，使 GridSplitter 真正可拖拽 -->
        <ColumnDefinition Width="640" MinWidth="420" MaxWidth="1200" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <TabControl Grid.Column="0" Margin="10">
        <!-- 截图 -->
        <TabItem Header="截图">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
              <GroupBox Header="全屏截图">
                <StackPanel>
                  <CheckBox Content="包含全部显示器（虚拟桌面）" IsChecked="{Binding CaptureAllMonitors}" Margin="0,0,0,8" />
                  <WrapPanel>
                    <Button Content="全屏截图并保存" Style="{StaticResource ToolButton}" Command="{Binding CaptureFullScreenCommand}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding LastCaptureInfo}" Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
              </GroupBox>

              <GroupBox Header="区域截图">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Style="{StaticResource FieldLabel}" />
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RegionX}" Margin="0,2" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" Style="{StaticResource FieldLabel}" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RegionY}" Margin="0,2" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="宽 / 高" Style="{StaticResource FieldLabel}" />
                  <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                    <TextBox Width="80" Text="{Binding RegionWidth}" Margin="0,0,8,0" />
                    <TextBox Width="80" Text="{Binding RegionHeight}" Margin="0,0,8,0" />
                    <Button Content="区域截图并保存" Style="{StaticResource ToolButton}"
                            Command="{Binding CaptureRegionCommand}" />
                  </WrapPanel>
                </Grid>
              </GroupBox>

              <GroupBox Header="窗口截图">
                <StackPanel>
                  <TextBlock Text="从当前可见窗口中选择目标" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}"
                              MinHeight="26" MaxDropDownHeight="420"
                              TextSearch.TextPath="Title"
                              ToolTip="选择目标窗口。列表较长时可在下拉列表内滚动，或直接用键盘输入标题前缀定位。">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" MaxWidth="440"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                            <!-- 最小化窗口无法截图，此处以文字标记而非仅靠颜色区分 -->
                            <TextBlock Text=" [已最小化]" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource DangerBrush}">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Content="刷新窗口" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" Command="{Binding RefreshWindowsCommand}"
                            ToolTip="重新枚举当前可见窗口，并尽量保留已选中的窗口。" />
                  </Grid>
                  <WrapPanel Margin="0,0,0,6">
                    <Button Content="后台窗口截图" Style="{StaticResource ToolButton}" Command="{Binding CaptureWindowCommand}" />
                    <Button Content="向该窗口后台投递文本" Style="{StaticResource ToolButton}" Command="{Binding PostTextToWindowCommand}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding SelectedWindowInfo}" Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- 全局快捷键 -->
        <TabItem Header="快捷键">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Margin="10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
              </Grid.RowDefinitions>

              <GroupBox Grid.Row="0" Header="注册新快捷键">
                <StackPanel>
                  <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="组合键" Style="{StaticResource FieldLabel}" />
                    <CheckBox Content="Ctrl" IsChecked="{Binding ModCtrl}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <CheckBox Content="Shift" IsChecked="{Binding ModShift}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <CheckBox Content="Alt" IsChecked="{Binding ModAlt}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <CheckBox Content="Win" IsChecked="{Binding ModWin}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <CheckBox Content="不重复触发" IsChecked="{Binding ModNoRepeat}" VerticalAlignment="Center" />
                  </WrapPanel>
                  <WrapPanel>
                    <ComboBox Width="180" ItemsSource="{Binding AvailableKeys}" SelectedItem="{Binding SelectedKey}"
                              DisplayMemberPath="DisplayName" MinHeight="26"
                              MaxDropDownHeight="420" Margin="0,0,8,8" />
                    <TextBox Width="220" Text="{Binding HotkeyAction}" Margin="0,0,8,8"
                             VerticalContentAlignment="Center" />
                    <Button Content="注册" Style="{StaticResource ToolButton}" Margin="0,0,0,8"
                            Command="{Binding RegisterHotkeyCommand}" />
                    <Button Content="注销所选" Style="{StaticResource ToolButton}" Margin="0,0,0,8"
                            Command="{Binding UnregisterHotkeyCommand}" />
                    <Button Content="全部注销" Style="{StaticResource ToolButton}" Margin="0,0,0,8"
                            Command="{Binding UnregisterAllHotkeysCommand}" />
                  </WrapPanel>
                </StackPanel>
              </GroupBox>

              <TextBlock Grid.Row="1" Text="已注册快捷键（触发后执行上方动作文本中的命令）"
                         Style="{StaticResource SectionHeader}" Margin="0,8,0,6" />

              <DataGrid Grid.Row="2" ItemsSource="{Binding Hotkeys}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                  <DataGridTextColumn Header="按键" Binding="{Binding KeyText}" Width="*" />
                  <DataGridTextColumn Header="修饰键" Binding="{Binding ModifierText}" Width="*" />
                  <DataGridTextColumn Header="触发次数" Binding="{Binding TriggerCount}" Width="90" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <!-- 输入模拟 -->
        <TabItem Header="输入模拟">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
              <GroupBox Header="前台输入（SendInput，绕过输入法）">
                <StackPanel>
                  <TextBlock Text="文本内容" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding ForegroundText}" Height="60" AcceptsReturn="True"
                           TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,8" />
                  <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="字符间隔(ms)" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="70" Text="{Binding CharDelay}" Margin="0,0,12,0" VerticalContentAlignment="Center" />
                    <TextBlock Text="随机抖动(ms)" Style="{StaticResource FieldLabel}" />
                    <TextBox Width="70" Text="{Binding CharJitter}" Margin="0,0,12,0" VerticalContentAlignment="Center" />
                  </WrapPanel>
                  <WrapPanel Margin="0,0,0,6">
                    <Button Content="发送到前台" Style="{StaticResource ToolButton}" Command="{Binding SendForegroundTextCommand}" />
                  </WrapPanel>
                  <TextBlock Text="{Binding InputResult}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </GroupBox>

              <GroupBox Header="按键模拟">
                <StackPanel>
                  <WrapPanel Margin="0,0,0,8">
                    <ComboBox Width="200" ItemsSource="{Binding AvailableKeys}" SelectedItem="{Binding SelectedSendKey}"
                              DisplayMemberPath="DisplayName" MinHeight="26"
                              MaxDropDownHeight="420" Margin="0,0,8,8" />
                    <CheckBox Content="Ctrl" IsChecked="{Binding SendModCtrl}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <CheckBox Content="Shift" IsChecked="{Binding SendModShift}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <CheckBox Content="Alt" IsChecked="{Binding SendModAlt}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <CheckBox Content="Win" IsChecked="{Binding SendModWin}" Margin="0,0,10,0" VerticalAlignment="Center" />
                  </WrapPanel>
                  <WrapPanel>
                    <Button Content="前台按键" Style="{StaticResource ToolButton}" Command="{Binding SendKeyCommand}" />
                    <Button Content="后台窗口按键" Style="{StaticResource ToolButton}" Command="{Binding PostKeyToWindowCommand}" />
                    <Button Content="写入窗口文本(WM_SETTEXT)" Style="{StaticResource ToolButton}" Command="{Binding SetWindowTextCommand}" />
                  </WrapPanel>
                </StackPanel>
              </GroupBox>

              <GroupBox Header="后台窗口文本投递">
                <StackPanel>
                  <TextBlock Text="目标窗口" Style="{StaticResource FieldLabel}" />
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}"
                              MinHeight="26" MaxDropDownHeight="420"
                              TextSearch.TextPath="Title"
                              ToolTip="选择目标窗口。列表较长时可在下拉列表内滚动，或直接用键盘输入标题前缀定位。">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" MaxWidth="440"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                            <!-- 最小化窗口无法截图，此处以文字标记而非仅靠颜色区分 -->
                            <TextBlock Text=" [已最小化]" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource DangerBrush}">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Content="刷新窗口" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" Command="{Binding RefreshWindowsCommand}"
                            ToolTip="重新枚举当前可见窗口，并尽量保留已选中的窗口。" />
                  </Grid>
                  <TextBlock Text="投递内容" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding BackgroundText}" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" Margin="0,2,0,8" />
                  <WrapPanel>
                    <Button Content="PostMessage 投递" Style="{StaticResource ToolButton}" Command="{Binding PostTextToWindowCommand}" />
                    <Button Content="替换窗口文本" Style="{StaticResource ToolButton}" Command="{Binding SetWindowTextCommand}" />
                  </WrapPanel>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- 钩子监听 -->
        <TabItem Header="钩子监听">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="140" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="低级输入钩子（全局键盘与鼠标）">
              <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                  <CheckBox Content="键盘钩子" IsChecked="{Binding KeyboardHookEnabled}" Margin="0,0,16,0" VerticalAlignment="Center" />
                  <CheckBox Content="鼠标钩子" IsChecked="{Binding MouseHookEnabled}" Margin="0,0,16,0" VerticalAlignment="Center" />
                  <TextBlock Text="过滤目标 PID（留空为全局）" Style="{StaticResource FieldLabel}" />
                  <TextBox Width="90" Text="{Binding FilterProcessId}" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                </WrapPanel>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="监听目标进程" Style="{StaticResource FieldLabel}" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}"
                            MinHeight="26" MaxDropDownHeight="420" Margin="0,0,8,0"
                            TextSearch.TextPath="Display"
                            ToolTip="选择需要监听输入的进程；标记为[无窗口]的进程同样可作为钩子目标。">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Display}" MaxWidth="520" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="2" Content="刷新进程" Style="{StaticResource ToolButton}"
                          Command="{Binding RefreshProcessesCommand}"
                          ToolTip="重新枚举当前进程，并尽量保留已选中的进程。" />
                </Grid>
                <WrapPanel>
                  <Button Content="应用钩子配置" Style="{StaticResource ToolButton}" Command="{Binding ApplyHookConfigCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding HookStatus}" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="实时事件">
              <ListBox ItemsSource="{Binding HookEvents}" FontFamily="Consolas" FontSize="12"
                       HorizontalContentAlignment="Stretch" />
            </GroupBox>
          </Grid>
        </TabItem>

        <!-- 窗口事件 -->
        <TabItem Header="窗口事件">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="140" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="目标进程窗口生命周期（WinEventHook）">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="目标进程" Style="{StaticResource FieldLabel}" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}"
                            MinHeight="26" MaxDropDownHeight="420" Margin="0,0,8,0"
                            TextSearch.TextPath="Display"
                            ToolTip="选择需要监听窗口创建与销毁的进程；WinEventHook 只接受单个进程 ID。">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Display}" MaxWidth="520" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="2" Content="刷新进程" Style="{StaticResource ToolButton}"
                          Command="{Binding RefreshProcessesCommand}"
                          ToolTip="重新枚举当前进程，并尽量保留已选中的进程。" />
                </Grid>
                <WrapPanel Margin="0,0,0,6">
                  <Button Content="开始监听" Style="{StaticResource ToolButton}" Command="{Binding StartWinEventHookCommand}" />
                  <Button Content="停止监听" Style="{StaticResource ToolButton}" Command="{Binding StopWinEventHookCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding WinEventStatus}" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="窗口事件流">
              <ListBox ItemsSource="{Binding WinEvents}" FontFamily="Consolas" FontSize="12"
                       HorizontalContentAlignment="Stretch" />
            </GroupBox>
          </Grid>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                    Background="{StaticResource BorderBrushSoft}"
                    ToolTip="拖动可调整左右面板宽度。" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="运行日志" Style="{StaticResource SectionHeader}" Margin="10,10,10,4" />

        <GroupBox Grid.Row="1" Header="NLog" Margin="10,0,10,10">
          <ListBox ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="12"
                   HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="NoWrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </GroupBox>
      </Grid>
    </Grid>

    <!-- 状态栏 -->
    <Border Grid.Row="2" Background="#F0F2F5" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="12,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding StatusBar}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        <WrapPanel Grid.Column="1">
          <TextBlock Text="Win7+ / net48 + net8.0 双目标" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button Content="退出" Style="{StaticResource ToolButton}" Command="{Binding ShutdownCommand}" />
        </WrapPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
