<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogToConsole="false">

  <!--
    日志配置。AppLogFactory 在启动早期以编程方式设置等价规则，
    本文件用于满足「配置可在不重启的情况下调整」与集中管理两项要求；
    加载顺序为：AppLogFactory 初始化 > 本文件（autoReload 生效）。
  -->

  <targets>
    <!-- 滚动文件：单文件 5MB，总量上限 20MB，保留 10 个历史文件 -->
    <target xsi:type="File"
            name="logfile"
            fileName="${basedir}/logs/gametools-${short-date}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${threadid}|${message} ${exception:format=ToString}"
            archiveAboveSize="5242880"
            archiveNumbering="Rolling"
            maxArchiveFiles="10"
            keepFileOpen="false"
            concurrentWrites="false"
            createDirs="true" />
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" writeTo="logfile" />
  </rules>

</nlog>